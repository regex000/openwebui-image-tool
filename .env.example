# Copy to .env (or just run ./scripts/init-env.sh, which also generates the secrets).
# .env is git-ignored. NEVER commit real keys.

# ---------------------------------------------------------------------------
# Chat model for Open WebUI (any OpenAI-compatible API; needs tool calling)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Image tool server
# ---------------------------------------------------------------------------
# Bearer token Open WebUI presents to the tool server (>= 24 chars; generated by init-env.sh).
TOOL_API_KEY=
# Optional: the previous key, still accepted while you rotate TOOL_API_KEY.
TOOL_API_KEY_PREVIOUS=
# HMAC key for signed image URLs (>= 24 chars; generated by init-env.sh).
URL_SIGNING_KEY=

# Host port of the tool server, and the URL your *browser* uses to load generated images.
# Leave PUBLIC_BASE_URL empty to use http://localhost:$TOOL_PORT (set it when behind a proxy).
TOOL_PORT=8001
PUBLIC_BASE_URL=

# auto  = OpenAI when an image API key is available, otherwise the offline mock provider
# openai | mock  force one
IMAGE_PROVIDER=auto
# Key for real image generation. Deliberately NOT inherited from OPENAI_API_KEY: the chat
# endpoint may be another vendor, and its key must never be sent to the image API.
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
# Plain-http image servers are refused when a key is set, unless you opt in (trusted LAN/localhost only).
IMAGE_API_ALLOW_INSECURE=false
# Model ids change often; see https://platform.openai.com/docs/models
IMAGE_MODEL=gpt-image-2
# low | medium | high | auto (leave empty for the provider default)
IMAGE_QUALITY=
# How long generated images (and their links) stay valid, and how many are kept at most.
IMAGE_TTL_SECONDS=604800
MAX_STORED_IMAGES=1000
# Max parallel generations, and the overall deadline for one call (keep < 240, Open WebUI's tool timeout).
MAX_CONCURRENCY=4
REQUEST_TIMEOUT_SECONDS=180
# true = serve Swagger UI at /docs on the tool server (leave off in shared environments).
ENABLE_DOCS=false

# ---------------------------------------------------------------------------
# Open WebUI
# ---------------------------------------------------------------------------
WEBUI_PORT=3000
# Pinned for reproducibility.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.12.0
# JWT signing secret (generated by init-env.sh).
WEBUI_SECRET_KEY=
# First admin account, created on the first start of an empty data volume (generated by
# init-env.sh). Public sign-up is disabled. After the first start you may blank
# WEBUI_ADMIN_PASSWORD and run `docker compose up -d` so it no longer sits in the container env.
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
# Optional: set to True to allow self-registration (new users start as "pending").
ENABLE_SIGNUP=False
# Origins allowed to call Open WebUI's API from a browser (';'-separated). Add the hostname
# or IP if you open the UI by something other than localhost.
CORS_ALLOW_ORIGIN=
# True = keep settings changed in the admin UI across restarts instead of
# re-applying the environment on every start.
OWUI_PERSISTENT_CONFIG=False
